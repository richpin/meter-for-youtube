{
  "manifest_version": 3,
  "name": "Meter for YouTube",
  "version": "0.1.0",
  "description": "오늘 유튜브에 쓴 이용 시간과 시청 시간을 유튜브 화면 위에 실시간으로 보여줍니다.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
