{
  "manifest_version": 3,
  "name": "Meter for YouTube",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "key": "",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Meter for YouTube"
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
